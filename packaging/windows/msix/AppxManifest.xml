<?xml version="1.0" encoding="utf-8"?>
<!-- Pacote MSIX do Elo para a Microsoft Store (scripts/pacote-msix.ps1).
     Os @CAMPOS@ vêm da reserva do nome no Partner Center (Produto >
     Identidade do produto): o script troca pelos valores das variáveis
     MSIX_NOME, MSIX_EDITOR e MSIX_EDITOR_NOME; MSIX_VERSAO vem do Cargo.toml.
     Sem eles, sai um pacote só para teste local. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity Name="@NOME@" Publisher="@EDITOR@" Version="@VERSAO@" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>@NOME_EXIBIDO@</DisplayName>
    <PublisherDisplayName>@EDITOR_NOME@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="pt-BR" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="Elo" Executable="elo.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="@NOME_EXIBIDO@"
        Description="Acesso remoto com cifragem ponta a ponta"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- "Iniciar com o computador": ligada pelo app (apps/elo/src/store.rs). -->
        <desktop:Extension Category="windows.startupTask" Executable="elo.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="EloInicio" Enabled="false" DisplayName="@NOME_EXIBIDO@" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <Capability Name="privateNetworkClientServer" />
    <!-- App de desktop (Win32): captura a tela e controla mouse e teclado. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
